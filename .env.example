# ERP System Environment Variables
# Copy this file to .env and fill in your actual values

# ======================
# Backend Configuration
# ======================

# Node Environment
NODE_ENV=development

# Server
PORT=3001

# Database - PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=erp_db
DATABASE_USER=erp_user
DATABASE_PASSWORD=your_secure_password_here

# Database - MongoDB
MONGODB_URI=mongodb://mongodb:27017/erp

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_128_CHARACTER_SECRET
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ======================
# Frontend Configuration
# ======================

# API Base URL (for NGINX proxy use /api, for direct backend use http://localhost:3001/api)
VITE_API_BASE_URL=/api

# WebSocket URL (for NGINX proxy use /, for direct backend use http://localhost:3001)
VITE_SOCKET_URL=/

# ======================
# Security Recommendations
# ======================

# Before deploying to production:
# 1. Generate a unique JWT_SECRET (128 characters):
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 2. Change DATABASE_PASSWORD to a strong password
#
# 3. Enable HTTPS/SSL in NGINX configuration
#
# 4. Change default admin password after first login:
#    Login with: admin / Admin@123!
#    Then: User Menu > Change Password
#
# 5. Review and update CORS settings in backend/src/main.ts if needed

# ======================
# Docker Compose
# ======================

# These values are used in docker-compose.yml
# Make sure they match between .env and docker-compose.yml

# Example production JWT secret (REPLACE THIS):
# JWT_SECRET=b9adcae340bc05b8b527f61067aaad6122cae3639e33e2ec39da3b68ae9d5ff64a080d73f62e384a8f40c49005d7bdf5647d36f019bc625d151f334ca680a4cf

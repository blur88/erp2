# ========================================
# ERP SYSTEM CONFIGURATION
# ========================================

# Application Configuration
NODE_ENV=development
PORT=3001

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=erp_db
DATABASE_USERNAME=erp_user
DATABASE_PASSWORD=your_secure_database_password_change_in_production
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false  # Set to false in production
DATABASE_SSL=false

# ========================================
# REDIS CONFIGURATION (Session Storage)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_change_in_production
REDIS_DB=0
REDIS_TTL=3600

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production-min-256-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_AUDIENCE=erp-app
JWT_ISSUER=erp-backend

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@company.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=ERP System <noreply@yourcompany.com>

# ========================================
# SECURITY CONFIGURATION
# ========================================

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Content Security Policy
CSP_REPORT_ONLY=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX=100           # Max requests per window per IP

# Security Headers
HSTS_MAX_AGE=31536000        # 1 year in seconds
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ========================================
# SECURITY MONITORING
# ========================================
SECURITY_ADMIN_EMAILS=admin@yourcompany.com,security@yourcompany.com
ENABLE_SECURITY_ALERTS=true

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760      # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,csv,xlsx

# ========================================
# BUSINESS LOGIC CONFIGURATION
# ========================================

# User Registration & Authentication
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in milliseconds

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000     # 30 minutes in milliseconds
PASSWORD_COMPLEXITY_ENABLED=true
MINIMUM_PASSWORD_LENGTH=8

# Session Management
MAX_SESSIONS_PER_USER=10
SESSION_CLEANUP_INTERVAL=3600000     # 1 hour in milliseconds

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_USER_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_ACCOUNT_LOCKOUT=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
ENABLE_INPUT_SANITIZATION=true
ENABLE_SECURITY_HEADERS=true

# ========================================
# LOGGING & MONITORING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=combined
ENABLE_REQUEST_LOGGING=true
ENABLE_METRICS=false

# ========================================
# DEVELOPMENT SETTINGS
# ========================================
ENABLE_SWAGGER=true
DEBUG_MODE=false

# ========================================
# FRONTEND CONFIGURATION
# ========================================
REACT_APP_API_URL=http://localhost:3001/api

# ========================================
# IMPORTANT SECURITY NOTES
# ========================================

# 1. CHANGE ALL DEFAULT PASSWORDS AND SECRETS BEFORE PRODUCTION
# 2. Use environment-specific .env files (.env.development, .env.production)
# 3. Never commit actual .env files to version control
# 4. Use strong, unique passwords for all services
# 5. Enable SSL/TLS in production (set NODE_ENV=production)
# 6. Regularly rotate JWT secrets and database passwords
# 7. Monitor security logs and implement alerting
# 8. Keep all dependencies updated
# 9. Use a secure secret management system in production
# 10. Implement backup and disaster recovery procedures
# =============================================================================
# ERP SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values according to your environment
# SECURITY: Never commit .env files to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3001
APP_NAME=ERP-System-Backend
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp_user
DB_PASSWORD=your_secure_database_password
DB_DATABASE=erp_system
DB_SCHEMA=public

# Database Connection Pool Settings
DB_CONNECTION_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=0
DB_IDLE_TIMEOUT=10000

# Database SSL (set to 'require' for production)
DB_SSL=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0
REDIS_TTL=300

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
# SECURITY: Use strong, randomly generated secrets in production!
# Generate with: openssl rand -base64 64

JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-please-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-app

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS Configuration - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Account Lockout Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_TIMEOUT=3600000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@company.com
MAIL_PASS=your-email-password
MAIL_FROM=ERP System <noreply@company.com>

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/csv,application/vnd.ms-excel

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Application Performance Monitoring
APM_SERVICE_NAME=erp-backend
APM_ENVIRONMENT=development

# Health Check Configuration
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Payment Gateway
PAYMENT_GATEWAY_URL=https://api.paymentgateway.com
PAYMENT_GATEWAY_API_KEY=your-payment-api-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# SMS Service
SMS_PROVIDER_URL=https://api.sms-provider.com
SMS_PROVIDER_API_KEY=your-sms-api-key
SMS_PROVIDER_SECRET=your-sms-secret

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Swagger API Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE=ERP System API
SWAGGER_DESCRIPTION=Comprehensive ERP System REST API
SWAGGER_VERSION=1.0

# Debug Settings
DEBUG_LEVEL=debug
DEBUG_SQL=false
DEBUG_REDIS=false

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 1. Change all default passwords and secrets
# 2. Use strong, randomly generated JWT secrets (64+ characters)
# 3. Set NODE_ENV=production
# 4. Enable SSL/TLS for database connections (DB_SSL=require)
# 5. Configure proper CORS origins (no wildcards)
# 6. Set up proper logging and monitoring
# 7. Enable database connection pooling
# 8. Configure rate limiting appropriately
# 9. Set up proper backup strategies
# 10. Review and test all security configurations
#!/usr/bin/env bash
# Stub for host `pg_dump`. STUB_PGDUMP_VERSION drives the major-version
# preflight; default is the supported 18.3.
printf 'pg_dump ARGC=%d\n' "$#" >> "$STUB_LOG"
_i=0
for _a in "$@"; do
  _i=$((_i + 1))
  printf 'pg_dump ARG[%d]=%s\n' "$_i" "$_a" >> "$STUB_LOG"
done

for arg in "$@"; do
  if [ "$arg" = "--version" ]; then
    printf 'pg_dump (PostgreSQL) %s\n' "${STUB_PGDUMP_VERSION:-18.3}"
    exit 0
  fi
done

# Schema dump body is not exercised by these specs.
printf '%s\n' "-- stub dump"
exit 0

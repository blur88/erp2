{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/modules/reports/**/*",
    "src/**/*.spec.ts",
    "src/**/__fixtures__/**/*",
    "test/**/*",
    "dist/**/*",
    "node_modules/**/*"
  ]
}

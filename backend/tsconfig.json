// Three roles (#2030):
// 1. Shared base that tsconfig.build.json, tsconfig.spec.json and
//    tsconfig.cli.json extend. Each of those sets its own `include`.
// 2. The runtime config ts-node loads for admin:create and
//    backup:reconcile-schedulers, so `module` must stay CommonJS.
// 3. Editor project for src/. test/tsconfig.json covers test/ with the ESM
//    settings Jest uses.
// `include` matches tsconfig.build.json's file set, so `npm run
// type-check:build` validates this program; test/unit/tsconfig-roles.spec.ts
// enforces that.
{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2025",
    // #1922: Keep omitted DTO fields absent so partial updates preserve existing values.
    "useDefineForClassFields": false,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "strict": false,
    "strictPropertyInitialization": false,
    "types": ["node", "jest", "multer", "archiver", "bcrypt", "compression", "express", "supertest"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@database/*": ["./src/database/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/modules/reports/**/*"
  ]
}

-export const cases = [...signout, ...switching, ...refresh, ...storage, ...marker, ...limiter, ...induced, ...companyRecovery]
+export const cases = [...signout, ...switching, ...refresh, ...storage, ...marker, ...limiter, ...induced, ...companyRecovery, ...companyRenewal]
   .sort((x, y) => x.id - y.id)
   .concat([w1])
 

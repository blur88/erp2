+    lastPollMsBeforeSignOut: signOutAt - polledAt,
+    nextPollDueMsAfterSignOut: nextPollDueAt - signOutAt,
+    redirectMsAfterSignOut: redirect.at === null ? null : redirect.at - signOutAt,
+    marginMs: POLL_MARGIN_MS,
+  })
+}

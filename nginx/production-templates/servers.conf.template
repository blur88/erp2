ssl_certificate /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;

# nginx can select a server during the TLS handshake. Check the HTTP
# authority as well before proxying from the canonical virtual server.
map $http_host $authority_hostname {
    default "";
    ~^(?<authority_name>[a-zA-Z0-9.-]+?)[.]?(?::[0-9]+)?$ $authority_name;
}

map "$host:$authority_hostname" $canonical_request {
    default 0;
    "${ERP_PUBLIC_HOST}:${ERP_PUBLIC_HOST}" 1;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        types {}
        default_type text/plain;
        autoindex off;
        limit_conn addr 50;
        limit_conn_status 429;
        try_files $uri =404;
    }

    location / {
        return 301 https://${ERP_PUBLIC_HOST}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    return 421;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ERP_PUBLIC_HOST};

    # Return through a named location whose header policy omits HSTS.
    error_page 421 = @misdirected;
    if ($canonical_request = 0) {
        return 421;
    }

    include /etc/nginx/app-server.conf;
    include /etc/nginx/hsts.conf;

    location @misdirected {
        add_header_inherit off;
        include /etc/nginx/security-headers.conf;
        return 421;
    }
}

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Prevent accidental root-level package files
/package.json
/package-lock.json

# Build outputs
dist/
build/
*/dist/
*/build/
*.tsbuildinfo
.next/
out/
.turbo

# Environment variables (CRITICAL - never commit actual .env files!)
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Keep template files (these should be committed)
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Lock files (keep only backend and frontend specific)
/yarn.lock
/pnpm-lock.yaml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.iml

# IDE files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.code-workspace

# Docker volumes and data (runtime data - never commit)
postgres-data/
mongo-data/
redis-data/
docker-volumes/
docker-compose.override.yml

# NOTE: .dockerignore, Dockerfile, and docker-compose.yml ARE committed

# Uploaded files
uploads/
backend/uploads/
frontend/uploads/
public/uploads/

# Backup files and archives
backups/
backend/backups/
*.tar.gz
*.sql
*.sql.gz
*.dump
*.bak
backup-*/
backup_*/

# Application logs
logs/
backend/logs/
frontend/logs/
*.log.*

# Coverage and test outputs
coverage/
*.coverage
.nyc_output/
junit.xml
test-results/
.vitest/
htmlcov/
.pytest_cache/

# NOTE: Test files (*.spec.ts, *.test.ts, etc.) are NOT ignored
# We have 81 tests that are part of the codebase and version controlled

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.yarn/
.pnpm-store/

# Temporary files
*.tmp
*.temp
tmp/
temp/
.tmp/
.temp/

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Migration artifacts (keep migrations, ignore temp files)
backend/src/migrations/*.js
backend/src/migrations/*.js.map

# Report exports (generated files)
exports/
reports/
*.xlsx
*.pdf
backend/exports/
frontend/exports/

# Redis dump files
dump.rdb

# Claude Code artifacts (temporary files only)
.claude/
# NOTE: CLAUDE.md is NOT ignored - it's the authoritative project documentation

# Binaries and executables
code

# Generated documentation
ERROR.md
TODOS.md

# Keep important documentation files (don't ignore)
# - CLAUDE.md (project instructions)
# - README.md (project overview)
# - plan.md (implementation plan)
# - SECURITY_AUDIT_PHASE4.md (security audit)
# - DEPLOYMENT_GUIDE.md (deployment guide)
# - PHASE*.md (phase completion summaries)
# - .env.example (environment template)

# Security and sensitive files
*.pem
*.key
*.cert
*.crt
secrets/
.secrets/

# JWT secrets (CRITICAL - never commit)
# Ensure .env contains JWT_SECRET and is gitignored above

# Debug files
debug/
*.debug

# Git worktree directories
.worktrees/
worktrees/

#!/bin/sh
# Refuses commit messages that carry prohibited Claude attribution (#1813):
# a Claude-Session trailer or a claude.ai/code/session_ link (AGENTS.md, Attribution).
# Activate once per clone: git config core.hooksPath .githooks
#
# Local check only, and it covers commit messages only. It does not check PR
# bodies, commits made with --no-verify, or commits in other clones.
#
# `git commit -v` appends the staged diff below a scissors line followed by git's
# sentinel line. Only that block is skipped. A scissors line typed by the user
# without the sentinel is ordinary message text and is checked.

msg_file="$1"
message=$(awk '
  pending {
    if ($0 ~ /^# Do not modify or remove the line above\.$/) exit
    pending = 0
  }
  /^# -+ >8 -+$/ { pending = 1 }
  { print }
' "$msg_file")

if printf '%s\n' "$message" | grep -q -i -F 'Claude-Session'; then
  echo "commit-msg: 'Claude-Session' trailers are refused (AGENTS.md, Attribution). Remove the trailer and commit again." >&2
  exit 1
fi

if printf '%s\n' "$message" | grep -q -i -F 'claude.ai/code/session_'; then
  echo "commit-msg: 'claude.ai/code/session_' session links are refused (AGENTS.md, Attribution). Remove the link and commit again." >&2
  exit 1
fi

exit 0

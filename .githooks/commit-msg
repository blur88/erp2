#!/bin/sh
# Refuses commit messages that carry prohibited Claude attribution (AGENTS.md,
# Attribution): Claude-Session trailers, claude.ai/code/session_ links, or
# Generated with Claude Code lines. Matching is case-insensitive.
# Activate once per clone: git config core.hooksPath .githooks
#
# Local check only, and it covers commit messages only. It does not check PR
# bodies, commits made with --no-verify, or commits in other clones.
#
# The whole message file is checked, including any text below a scissors line.
# `git commit -v` appends the staged diff to that file, so a staged change that
# names a prohibited string is refused too. Commit such a change with -m or -F.
# Scanning everything keeps a typed scissors line from hiding a trailer.

msg_file="$1"

if grep -q -i -F 'Claude-Session' "$msg_file"; then
  echo "commit-msg: 'Claude-Session' trailers are refused (AGENTS.md, Attribution). Remove the trailer and commit again." >&2
  exit 1
fi

if grep -q -i -F 'claude.ai/code/session_' "$msg_file"; then
  echo "commit-msg: 'claude.ai/code/session_' session links are refused (AGENTS.md, Attribution). Remove the link and commit again." >&2
  exit 1
fi

if grep -q -i -E 'Generated with \[?Claude Code' "$msg_file"; then
  echo "commit-msg: 'Generated with Claude Code' lines are refused (AGENTS.md, Attribution). Remove the line and commit again." >&2
  exit 1
fi

exit 0
